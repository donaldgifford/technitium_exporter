# If you prefer the allow list template instead of the deny list, see community
# template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
# `go build ./cmd/technitium_exporter` with no -o drops the binary here.
/technitium_exporter

# Build output
build/
dist/

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Local env — where TECHNITIUM_URL / TECHNITIUM_TOKEN belong. Loaded
# automatically by `set dotenv-load` in the justfile. Never commit credentials.
.env
.env.local

# Editor/IDE
.idea/
.vscode/

# Claude Code: settings.json is shared project config and is tracked; the rest
# of .claude/ is per-session machine state. The glob (not `.claude/`) matters --
# git cannot re-include a file inside an ignored directory, so ignoring the
# directory itself would make the negation below a no-op.
.claude/*
!.claude/settings.json

# Scratch file holding the literal secret for git-filter-repo (never commit)
.token-to-purge
